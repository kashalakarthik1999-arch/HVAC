def extract_field(field_config, full_text):

    field_name = field_config.get("name")
    # Type 1: Do not extract another column when Brand is blank.
    if field_name == "manufacturer":
        type1_table = (
            "Existing HVAC Equipment Demographic Information" in full_text
            and re.search(r"\bBRAND\b.*\bMODEL\b", full_text, re.IGNORECASE | re.DOTALL)
        )

        if type1_table:
            blank_brand = re.search(
                r"\b00[1-9]\s+UNAVAILABLE\s+UNAVAILABLE\b",
                full_text,
                re.IGNORECASE
            )
        #     print("Yes,ITS WORKING")
        #     if blank_brand:
        #         return None
    patterns = field_config.get("patterns", [])
        
    if isinstance(patterns, str):
        patterns = [patterns]

    normalized_text = re.sub(r"\s+", " ", full_text)

    texts_to_search = [full_text, normalized_text]

    for pattern in patterns:
        try:
            for text in texts_to_search:

                matches = re.finditer(
                    pattern,
                    text,
                    flags=re.IGNORECASE
                )

                for match in matches:

                    if match.lastindex:
                        value = match.group(1)
                    else:
                        value = match.group(0)

                    value = clean_value(value)

                    if not value:
                        continue

                    # Specific validation for equipment model
                    if field_name == "equipment_model":

                        invalid_values = [
                            "SERIAL",
                            "SERIAL#",
                            "S/N",
                            "MODEL",
                            "MODEL #",
                            "MODEL#"
                        ]

                        if value.upper() in invalid_values:
                            continue

                    return value

        except re.error as error:
            raise ValueError(
                f"Invalid regex for field "
                f"{field_name}: {error}"
            )

    return None

# Type 2 Insured Quote columns Extraction
def extract_type2_cost_summary(section):

    # Keep original line breaks for description extraction
    original_text = section

    # Normalize whitespace for total extraction
    text = re.sub(r"\s+", " ", section)

    costs = {
        "insured_quoted_manufacturer": None,
        "insured_quote_total": None,
        "insured_market_parts_cost": None,
        "insured_market_labour_cost": None,
        "insured_market_pricing_total": None,
    }

    # ------------------------------------------------
    # 1. INSURED'S QUOTE SECTION
    # ------------------------------------------------

    insured_match = re.search(
        r"Insured[’']s\s+Quote(.*?)(?=iCheck\s+Market\s+Pricing|$)",
        text,
        re.IGNORECASE
    )

    if insured_match:

        insured_text = insured_match.group(1)

        # Extract Quote Total
        quote_total_match = re.search(
            r"Quote\s+Total\s*:?\s*\$?\s*([\d,]+\.\d{2})",
            insured_text,
            re.IGNORECASE
        )

        if quote_total_match:
            costs["insured_quote_total"] = float(
                quote_total_match.group(1).replace(",", "")
            )

        # Extract first line-item description from Insured Quote table

        insured_description_match = re.search(
            r"V?\s*Insured['’]?s\s+Quote"
            r".*?LINE\s+ITEM\s+DESCRIPTION"
            r".*?W/TAX\s+COST\s+"
            r"([A-Za-z0-9][A-Za-z0-9&.,'()/ _-]*?)"
            r"\s+\$[\d,]+\.\d{2}",
            insured_text,
            re.IGNORECASE | re.DOTALL
        )

        if insured_description_match:

            description = insured_description_match.group(1).strip()

            costs["insured_quoted_manufacturer"] = description

        else:

            costs["insured_quoted_manufacturer"] = None

    # ------------------------------------------------
    # 2. ICHECK MARKET PRICING SECTION
    # ------------------------------------------------

    market_match = re.search(
        r"iCheck\s+Market\s+Pricing(.*)",
        text,
        re.IGNORECASE
    )

    if market_match:

        market_text = market_match.group(1)

        # Extract System Total: Parts Cost and Labor Cost
        system_total_match = re.search(
            r"System\s+Total\s*:?\s*"
            r"\$?\s*([\d,]+\.\d{2})\s+"
            r"[\d,.]+\s+"
            r"\$?\s*([\d,]+\.\d{2})",
            market_text,
            re.IGNORECASE
        )

        if system_total_match:

            costs["insured_market_parts_cost"] = float(
                system_total_match.group(1).replace(",", "")
            )

            costs["insured_market_labour_cost"] = float(
                system_total_match.group(2).replace(",", "")
            )

        # Extract Market Pricing Total
        market_total_match = re.search(
            r"Market\s+Pricing\s+Total\s*:?\s*"
            r"\$?\s*([\d,]+\.\d{2})",
            market_text,
            re.IGNORECASE
        )

        if market_total_match:

            costs["insured_market_pricing_total"] = float(
                market_total_match.group(1).replace(",", "")
            )

        # Extract first line-item description from iCheck table
        # market_description_match = re.search(
        #     r"LINE\s+ITEM\s+LABOR\s+LINE\s+ITEM\s+DESCRIPTION"
        #     r".*?"
        #     r"([A-Za-z][A-Za-z0-9&.,'()/ -]*?)\s+"
        #     r"\$[\d,]+\.\d{2}\s+"
        #     r"[\d.]+\s+"
        #     r"\$[\d,]+\.\d{2}\s+"
        #     r"\$[\d,]+\.\d{2}",
        #     market_text,
        #     re.IGNORECASE
        # )

        # if market_description_match:

        #     costs["market_pricing_description"] = (
        #         market_description_match.group(1).strip()
        #     )

    return costs

def extract_type2_equipment(full_text):

    import re

    equipment_records = []

    # Split at each numbered equipment section
    sections = re.split(
        r'(?=\b\d{2}\s*Date\s*Make\s*:)',
        full_text,
        flags=re.IGNORECASE
    )

    for section in sections:

        number_match = re.search(
            r'\b(\d{2})\s*Date\s*Make\s*:',
            section,
            re.IGNORECASE
        )

        if not number_match:
            continue

        manufacturer_match = re.search(
            r'Date\s*Make\s*:\s*of\s*(.*?)\s*Manufacture\s*:',
            section,
            re.IGNORECASE
        )

        year_match = re.search(
            r'Manufacture\s*:\s*(\d{4})\b',
            section,
            re.IGNORECASE
        )

        model_match = re.search(
            r'\bModel\s*:\s*([A-Za-z0-9./_-]+)',
            section,
            re.IGNORECASE
        )

        #cost columns extraction
        cost_summary = extract_type2_cost_summary(section)

        equipment_records.append({
            "equipment_number": number_match.group(1),
            "manufacturer": (
                manufacturer_match.group(1).strip()
                if manufacturer_match else None
            ),
            "equipment_year": (
                int(year_match.group(1))
                if year_match else None
            ),
            "equipment_model": (
                model_match.group(1).strip()
                if model_match else None
            ),

            **cost_summary
        })

    return equipment_records


def clean_value(value):
    value = str(value).strip()
    value = re.sub(r"\s+", " ", value)

    return value if value else None


