def extract_equipment_table(pdf_path):

    equipment_rows = []

    doc = fitz.open(pdf_path)

    try:
        for page in doc:

            tables = page.find_tables()

            for table in tables.tables:

                data = table.extract()

                if not data:
                    continue

                header_index = None

                # Identify only the HVAC equipment table
                for i, row in enumerate(data):

                    headers = [
                        re.sub(
                            r"[^a-z0-9]",
                            "",
                            str(cell or "").lower()
                        )
                        for cell in row
                    ]

                    if (
                        "brand" in headers
                        and "model" in headers
                        and "serial" in headers
                        and "age" in headers
                    ):
                        header_index = i
                        break

                # Ignore unrelated tables
                if header_index is None:
                    continue

                headers = [
                    re.sub(
                        r"[^a-z0-9]",
                        "",
                        str(cell or "").lower()
                    )
                    for cell in data[header_index]
                ]

                column_map = {}

                for index, header in enumerate(headers):

                    if header == "brand":
                        column_map["manufacturer"] = index

                    elif header == "model":
                        column_map["equipment_model"] = index

                    elif header == "serial":
                        column_map["serial_number"] = index

                    elif header == "age":
                        column_map["equipment_age"] = index

                    elif header == "causeofloss":
                        column_map["equipment_cause_of_loss"] = index

                    elif header == "tonbtu":
                        column_map["ton_btu"] = index

                    elif header == "systemtype":
                        column_map["system_type"] = index

                    elif header == "recommendation":
                        column_map["equipment_recommendation"] = index

                # Process only actual equipment rows
                for row in data[header_index + 1:]:

                    if not row:
                        continue

                    # First column should contain equipment ID: 001, 002, etc.
                    equipment_id = str(row[0] or "").strip()

                    if not re.fullmatch(r"\d{3}", equipment_id):
                        continue

                    record = {}

                    for field, index in column_map.items():

                        if index < len(row):
                            record[field] = str(
                                row[index] or ""
                            ).strip()

                    # Manufacturer must be present
                    if not record.get("manufacturer"):
                        continue

                    record["equipment_id"] = equipment_id

                    equipment_rows.append(record)

    finally:
        doc.close()

    return equipment_rows
