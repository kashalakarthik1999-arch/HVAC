
def extract_type2_equipment(full_text):

    import re

    equipment_records = []

    # Split at each numbered equipment section
    sections = re.split(
        r'(?=\b\d{2}\s*Date\s*Make\s*:)',
        full_text,
        flags=re.IGNORECASE
    )

    for section in sections:

        number_match = re.search(
            r'\b(\d{2})\s*Date\s*Make\s*:',
            section,
            re.IGNORECASE
        )

        if not number_match:
            continue

        manufacturer_match = re.search(
            r'Date\s*Make\s*:\s*of\s*(.*?)\s*Manufacture\s*:',
            section,
            re.IGNORECASE
        )

        year_match = re.search(
            r'Manufacture\s*:\s*(\d{4})\b',
            section,
            re.IGNORECASE
        )

        model_match = re.search(
            r'\bModel\s*:\s*([A-Za-z0-9./_-]+)',
            section,
            re.IGNORECASE
        )

        equipment_records.append({
            "equipment_number": number_match.group(1),
            "manufacturer": (
                manufacturer_match.group(1).strip()
                if manufacturer_match else None
            ),
            "equipment_year": (
                int(year_match.group(1))
                if year_match else None
            ),
            "equipment_model": (
                model_match.group(1).strip()
                if model_match else None
            )
        })

    return equipment_records





