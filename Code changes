def extract_equipment_table(pdf_path):

    equipment_rows = []

    doc = fitz.open(pdf_path)

    try:
        for page in doc:

            tables = page.find_tables()

            for table in tables.tables:

                data = table.extract()

                if not data:
                    continue

                header_index = None

                for i, row in enumerate(data):

                    headers = [
                        re.sub(
                            r"[^a-z0-9]",
                            "",
                            str(cell or "").lower()
                        )
                        for cell in row
                    ]

                    if (
                        "brand" in headers
                        and any("model" in h for h in headers)
                        and "age" in headers
                    ):
                        header_index = i
                        break

                if header_index is None:
                    continue

                headers = [
                    re.sub(
                        r"[^a-z0-9]",
                        "",
                        str(cell or "").lower()
                    )
                    for cell in data[header_index]
                ]

                column_map = {}

                for index, header in enumerate(headers):

                    if header == "brand":
                        column_map["manufacturer"] = index

                    elif "model" in header:
                        column_map["equipment_model"] = index

                    elif "serial" in header:
                        column_map["serial_number"] = index

                    elif header == "age":
                        column_map["equipment_age"] = index

                    elif "systemtype" in header:
                        column_map["system_type"] = index

                    elif "causeofloss" in header:
                        column_map["equipment_cause_of_loss"] = index

                    elif "recommendation" in header:
                        column_map["equipment_recommendation"] = index

                for row in data[header_index + 1:]:

                    record = {}

                    for field, index in column_map.items():

                        if index < len(row):
                            record[field] = str(
                                row[index] or ""
                            ).strip()

                    # Ignore empty rows
                    if record.get("manufacturer") or record.get("equipment_model"):
                        equipment_rows.append(record)

    finally:
        doc.close()

    return equipment_rows



