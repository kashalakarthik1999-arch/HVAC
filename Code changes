def detect_pdf_type(full_text):

    # Type 2: Existing HVAC Equipment Demographic Information
    if re.search(
        r"Existing\s+HVAC\s+Equipment\s+Demographic\s+Information",
        full_text,
        re.IGNORECASE
    ):
        return "Type 2"

    # Type 1: Insured's Quote
    elif re.search(
        r"Insured['’]s\s+Quote",
        full_text,
        re.IGNORECASE
    ):
        return "Type 1"

    else:
        return "Unknown"


