# Calculate Unit Age
if "date_of_loss" in data_df.columns and "equipment_year" in data_df.columns:
    loss_year = pd.to_datetime(
        data_df["date_of_loss"],
        errors="coerce"
    ).dt.year

    equipment_year = pd.to_numeric(
        data_df["equipment_year"],
        errors="coerce"
    )

    data_df["unit_age"] = loss_year - equipment_year
else:
    data_df["unit_age"] = None
